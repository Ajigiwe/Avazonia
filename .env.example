# AVAZONIA — LOCAL DEVELOPMENT ENV
# Copy to .env:  copy .env.example .env   (Windows)  /  cp .env.example .env  (Mac/Linux)
# Docker Compose reads .env automatically. Native PHP (`php -S`) also reads it via config/app.php.

# --- APP ---
APP_NAME=Avazonia
APP_URL=http://localhost:8080
# When running WITHOUT Docker (native php -S), use:
# APP_URL=http://localhost:8000

# --- DATABASE ---
# Docker: host must be `db` (service name). Native MySQL: `127.0.0.1`. SQLite fallback: set DB_DRIVER=sqlite
DB_HOST=db
DB_NAME=avazonia
DB_USER=avazonia
DB_PASS=avazonia
DB_PORT=3306
# DB_DRIVER=sqlite  # uncomment to force SQLite (storage/database.sqlite) — no MySQL needed, zero-config

# --- PAYSTACK (use test keys locally; leave blank to skip payment) ---
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- BUSINESS CONTACT ---
WHATSAPP_NUMBER=233240000000
SITE_EMAIL=hello@avazonia.local

# --- EMAIL (local: logs only — no real mail sent) ---
# Options: brevo | mailersend | smtp | log
MAIL_MAILER=log
BREVO_API_KEY=
MAILERSEND_API_KEY=
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=hello@avazonia.local
MAIL_FROM_NAME=Avazonia
MAIL_ENCRYPTION=
MAIL_DEBUG=0
