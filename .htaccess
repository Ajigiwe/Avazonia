# 🔒 AVAZONIA PRODUCTION HARDENING
Options -Indexes
RewriteEngine On

# PHP upload limits for the production LiteSpeed/Apache handler.
# The host was still enforcing its default 8M post_max_size despite .user.ini.
php_value upload_max_filesize 32M
php_value post_max_size 128M
php_value max_file_uploads 20
php_value max_execution_time 120
php_value max_input_time 120
php_value memory_limit 256M

# Force HTTPS (DISABLED FOR LOCALHOST COMPATIBILITY)
# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP_HOST} !^localhost$ [NC]
# RewriteCond %{HTTP_HOST} !^127\.0\.0\.1$
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block sensitive files
<Files ".env">
    Order allow,deny
    Deny from all
</Files>

<Files "*.sql">
    Order allow,deny
    Deny from all
</Files>

# ── Block development / deploy tooling from the web ─────────────────
# These are CLI + SSH utilities, not web endpoints. Several of them are
# unauthenticated and mutate the DB or run `git reset --hard` on the server.
# They stay in the repo and remain usable via `php <file>` over SSH.
# Root-only patterns (anchored ^...$) so nothing in admin/ or api/ is affected.
RewriteRule ^(deploy|diagnose|run_migrations|read_logs|test_upload|router)\.php$ - [F,L]
RewriteRule ^(check|debug)_.*\.php$ - [F,L]
RewriteRule ^(seed|move)_.*\.php$ - [F,L]

# Whole directories that must never be web-reachable.
RewriteRule ^(bin|scratch)/ - [F,L]

# Route everything to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]

# PWA Support — set correct MIME for the web app manifest
AddType application/manifest+json .webmanifest .json
<FilesMatch "manifest\.(webmanifest|json)$">
    Header set Content-Type "application/manifest+json"
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>
